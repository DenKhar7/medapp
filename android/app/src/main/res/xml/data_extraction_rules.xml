<?xml version="1.0" encoding="utf-8"?>
<!--
    Données de santé (traitements, ordonnances, profils) : aucune sauvegarde cloud ni transfert automatique.
    Voir aussi android:allowBackup="false" dans le manifeste.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
