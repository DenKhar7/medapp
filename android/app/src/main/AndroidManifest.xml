<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MedicAppApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.App_Mobile"
        >
        <!-- Écran de démarrage - Point d'entrée LAUNCHER -->
        <activity
            android:name=".view.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App_Mobile.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran de connexion - Plus le LAUNCHER, accès via Splash ou logout -->
        <activity
            android:name=".view.ConnectionActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">
        </activity>
        <activity android:name=".view.HomeActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.MedicamentActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.PathologieActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.OrdonnanceActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.RegisterActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            />
        <activity android:name=".view.AccountActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.CreateOrdonnanceActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.AddTreatmentActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.AddProfileActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.UserTreatmentsActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.EditProfileActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".view.SelectMedicamentActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>


        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
        <receiver
            android:name="iut.butinfo3.app_mobile.reminder.ReminderBroadcastReceiver"
            android:exported="false" />

        <receiver android:name=".reminder.NotificationActionReceiver"
            android:exported="false"
            >
            <intent-filter>
                <action android:name="iut.butinfo3.app_mobile.ACTION_TAKEN" />
                <action android:name="iut.butinfo3.app_mobile.ACTION_SNOOZE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true"> <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.TIME_SET" /> <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        </intent-filter>
        </receiver>
    </application>

</manifest>